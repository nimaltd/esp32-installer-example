# example's settings, made once by lib-installer and yours from now on.
# No install writes over this file. The project's CMakeLists.txt adds it to
# SDKCONFIG_DEFAULTS, after sdkconfig.defaults, so a setting here wins. Like
# any defaults file, it counts for a symbol sdkconfig does not have yet.
CONFIG_EXAMPLE_PERIOD_MS=500
CONFIG_EXAMPLE_GREETING="Hello from example"
